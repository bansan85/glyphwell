# Copier en `.env` et ajuster. Toutes les variables sont optionnelles :
# `glyphwell.config.Settings` fournit des valeurs par défaut utilisables.

# Racine de toutes les données produites (corpus, datasets, base SQLite).
# ⚠️ Le corpus anglais complet pèse plusieurs dizaines de Go décompressés.
GLYPHWELL_DATA_DIR=./data

# Chemin de la base SQLite. Par défaut : <data_dir>/glyphwell.db
# GLYPHWELL_DATABASE=./data/glyphwell.db

# Serveur Ollama
GLYPHWELL_OLLAMA_HOST=http://localhost:11434
GLYPHWELL_OLLAMA_TIMEOUT=300

# Nombre de blocs analysés en parallèle par une recherche.
GLYPHWELL_CONCURRENCY=4

# Corpus OPUS ciblé
GLYPHWELL_OPUS_CORPUS=OpenSubtitles
GLYPHWELL_OPUS_VERSION=v2018
GLYPHWELL_OPUS_LANGUAGE=en

# Niveau de journalisation : DEBUG | INFO | WARNING | ERROR
GLYPHWELL_LOG_LEVEL=INFO
