# Copy to `.env` and adjust. All variables are optional:
# `glyphwell.config.Settings` provides usable defaults.

# Root of all produced data (corpus, datasets, SQLite databases).
# Warning: the full English archive weighs several dozen GB. It is never
# decompressed: plan for its size, not double it.
GLYPHWELL_DATA_DIR=./data

# Path to the catalog database (corpus + IMDb data, immutable once fetched).
# Default: <data_dir>/glyphwell.db
# GLYPHWELL_CATALOG_DATABASE=./data/glyphwell.db

# Path to a search's run database (runs, run_files, results). Only meaningful together
# with a manifest (search run/resume/status/export); normally left unset.
# Default: <data_dir>/<manifest filename without .yaml>.db
# GLYPHWELL_RUN_DATABASE=./data/example.db

# Ollama server
GLYPHWELL_OLLAMA_HOST=http://localhost:11434
GLYPHWELL_OLLAMA_TIMEOUT=300

# Number of chunks analyzed in parallel by a search.
GLYPHWELL_CONCURRENCY=4

# Targeted OPUS corpus
GLYPHWELL_OPUS_CORPUS=OpenSubtitles
GLYPHWELL_OPUS_VERSION=v2024
GLYPHWELL_OPUS_LANGUAGE=en

# Verify the TLS certificate of the download servers (OPUS, IMDb).
# `false` is the equivalent of wget's --no-check-certificate, also available as the
# `--no-check-certificate` global option. Behind a TLS-inspecting corporate proxy,
# prefer keeping verification on and pointing httpx at the CA to trust:
#   SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# GLYPHWELL_VERIFY_TLS=true

# Log level: DEBUG | INFO | WARNING | ERROR
GLYPHWELL_LOG_LEVEL=INFO
