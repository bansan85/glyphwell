# Copy to `.env` and adjust. All variables are optional:
# `glyphwell.config.Settings` provides usable defaults.

# Root of all produced data (corpus, datasets, SQLite database).
# Warning: the full English archive weighs several dozen GB. It is never
# decompressed: plan for its size, not double it.
GLYPHWELL_DATA_DIR=./data

# Path to the SQLite database. Default: <data_dir>/glyphwell.db
# GLYPHWELL_DATABASE=./data/glyphwell.db

# Ollama server
GLYPHWELL_OLLAMA_HOST=http://localhost:11434
GLYPHWELL_OLLAMA_TIMEOUT=300

# Number of chunks analyzed in parallel by a search.
GLYPHWELL_CONCURRENCY=4

# Targeted OPUS corpus
GLYPHWELL_OPUS_CORPUS=OpenSubtitles
GLYPHWELL_OPUS_VERSION=v2024
GLYPHWELL_OPUS_LANGUAGE=en

# Log level: DEBUG | INFO | WARNING | ERROR
GLYPHWELL_LOG_LEVEL=INFO
