# Virtual environments
.venv/
venv/
env/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Project data: OPUS corpus, IMDb datasets, SQLite databases.
# Large (several dozen GB) and fully reconstructible.
# Anchored at the root: an unanchored `data/` rule would also exclude tests/data/,
# i.e. the test fixtures, and CI would fail on a fresh clone.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets and local configuration
.env
.env.local

# Editors / OS
.idea/
.vscode/
Thumbs.db
desktop.ini
.DS_Store
